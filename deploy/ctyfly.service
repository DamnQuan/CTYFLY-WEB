[Unit]
Description=CTY 飞控 后端 API（FastAPI/Uvicorn）
After=network.target

[Service]
Type=simple
# 专用低权限用户，2026-10-04 已在服务器执行 useradd + chown -R ctyfly:ctyfly /opt/ctyfly。
# 注意：deploy.ps1 部署解包后会对 app 目录重新 chown，保持属主一致。
User=ctyfly
Group=ctyfly
WorkingDirectory=/opt/ctyfly/backend
# 生产参数：单进程 + 不暴露 Server 头，见 run.py，端口与代理配置来自 .env
ExecStart=/opt/ctyfly/backend/venv/bin/python run.py
Restart=always
RestartSec=3
# 崩溃自动重启；日志进 journald
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
# 资源保护：内存超限自动重启而非拖垮整机
MemoryMax=700M

# ---- 安全加固，保守档，均为 systemd 内建沙箱开关----
# 禁止服务进程及其子进程通过 setuid/sudo 提权
NoNewPrivileges=true
# /tmp、/var/tmp 使用独立的私有命名空间，防止 tmp 目录下的符号链接攻击与临时文件互相可见
PrivateTmp=true
# /usr、/boot、/etc 挂载为只读，/opt 不受影响，仍可写；
# 比 ProtectSystem=strict 温和，不会挡住 venv、数据目录与备份写入
ProtectSystem=full
# /home 挂载为只读。/opt 不在 /home 之下，设 true 不影响后端读写 /opt/ctyfly
ProtectHome=true

[Install]
WantedBy=multi-user.target
