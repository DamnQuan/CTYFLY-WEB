[Unit]
Description=CTY 飞控 后端 API（FastAPI/Uvicorn）
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ctyfly/backend
# 生产参数：单进程 + 不暴露 Server 头，见 run.py，端口与代理配置来自 .env
ExecStart=/opt/ctyfly/backend/venv/bin/python run.py
Restart=always
RestartSec=3
# 崩溃自动重启；日志进 journald
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
# 资源保护：内存超限自动重启而非拖垮整机
MemoryMax=700M

[Install]
WantedBy=multi-user.target
