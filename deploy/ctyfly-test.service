[Unit]
Description=CTYFLY test.ccflysim.cn（测试环境，独立数据库）
After=network.target

[Service]
Type=simple
User=ctyfly
Group=ctyfly
WorkingDirectory=/opt/ctyfly-test/backend
# 必须是 test 自己的 venv：2026-10-05 之前这里是 /opt/ctyfly/backend/venv/bin/python，
# 且 /opt/ctyfly-test/backend/venv 只是指回生产 venv 的符号链接 —— 等于两个环境共用
# 一套依赖，改生产依赖会连带影响测试环境。已拆成独立 venv，关键包版本与生产一致。
ExecStart=/opt/ctyfly-test/backend/venv/bin/python run.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PORT=3016
Environment=PROXY_HEADERS=true
MemoryMax=500M

# ---- 安全加固，与 ctyfly.service 同档----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
