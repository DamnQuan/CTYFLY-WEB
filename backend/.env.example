# ===== CTY 飞控后端配置，Python / FastAPI=====
# 复制本文件为 .env 并按需修改，放在 backend/ 目录下

# API 端口
PORT=3001

# JWT 密钥，生产环境务必修改为随机长字符串
JWT_SECRET=please-change-me-to-a-random-long-string
JWT_EXPIRES=6h

# ---- CORS 与反向代理 ----
# 允许跨域访问 API 的前端来源，逗号分隔。生产环境改成正式域名，
# 不要保留 localhost 来源，避免任意页面带着用户凭据调你的 API。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# 是否信任反向代理传来的 X-Forwarded-For，Nginx 反代部署设 true；
# 直连部署必须 false，否则客户端可伪造 XFF 绕过限流与人机验证豁免。
TRUST_PROXY=false
# 反向代理部署，Nginx 同机时设 true：uvicorn 依据 X-Forwarded-For 重写客户端 IP。
# 与 TRUST_PROXY 一同配置；直连部署保持 false。
PROXY_HEADERS=false
# 是否开启 FastAPI 文档页，/api/docs 与 /api/openapi.json。生产环境保持 false，不对外暴露接口文档。
# 注意 /docs 已被前端平台发展问卷页占用，不能再给接口文档。
ENABLE_DOCS=false
# 是否启用限流。仅本地调试时临时关闭，生产环境必须保持 true。
RATE_LIMIT_ENABLED=true

# ---- 本地上传，航司 Logo 等图片----
# 落盘目录，不入 git，由 UPLOAD_URL_PREFIX 路径静态托管。
# 不配置时默认 backend/data/uploads，以 backend 目录为基准的绝对路径，最稳妥。
# UPLOAD_DIR=data/uploads
# 上传文件的 URL 前缀
UPLOAD_URL_PREFIX=/uploads
# 单张图片上限，字节，默认 2MB，仅对上传接口放宽，其余接口仍为 128KB
MAX_UPLOAD_BYTES=2097152

# ---- 工单附件，图片 / PDF / Word----
# 存放目录：与公开托管的 uploads 目录物理隔离，data/attachments 不入 nginx，
# 只能经 /api/attachments/{id} 带鉴权读取，仅工单主人与管理员可见。
# 不配置时默认 backend/data/attachments，绝对路径。
# ATTACH_DIR=data/attachments
# 单个附件上限，字节，默认 5MB
MAX_ATTACH_BYTES=5242880
# 每个工单最多附件数
MAX_ATTACH_PER_TICKET=6

# ---- 航路规划 sidecar，Node 服务，读取 AIRAC nd.db3----
# 后端自动拉起的 sidecar 服务地址，同机部署保持默认
NAVDATA_SIDECAR_URL=http://127.0.0.1:4173
# sidecar 代码目录。不配置时默认 backend/navdata-planner，绝对路径。
# NAVDATA_SIDECAR_DIR=navdata-planner
# 可选：指定 nd.db3 的自定义位置；不填则用 sidecar 目录内默认位置
# NAVDATA_DB=/opt/ctyfly/navdata/nd.db3

# ---- SMTP 邮件，用于注册/找回密码验证码----
# 未配置时进入开发模式：验证码直接返回给前端页面并打印到后端控制台
# 注意：真实的 SMTP_PASS，授权码只写在 .env，不入 git，不要提交到本文件
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASS=你的SMTP授权码
# 发件人显示，默认同 SMTP_USER
SMTP_FROM=noreply@your-domain.com

# ---- 桌宠 AI 对话，火山方舟 / 豆包----
# 不填 ARK_API_KEY 也能用：桌宠会自动降级为内置的预设台词 + 关键词应答。
# 真实 Key 只写在 .env，不入 git。
ARK_API_KEY=你的火山方舟APIKey
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-evolving
PET_AI_ENABLED=true
# 调用方舟接口的超时秒数
ARK_TIMEOUT=25
# 送给模型的历史对话轮数，仅进程内保存，不落库
PET_HISTORY_TURNS=6
# 单次回复输出上限；该模型是推理模型，代码里已强制关闭思考
PET_MAX_TOKENS=220
# 全站每日调用上限，用来兜住成本
PET_DAILY_LIMIT=2000

# 站点公开访问地址：通知邮件里的站点链接/域名引用，换域名时改这里
SITE_PUBLIC_URL=https://test.ccflysim.cn

# ---- 初始管理员账号，首次启动时自动创建----
ADMIN_CID=1000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__请设置强口令__
ADMIN_EMAIL=admin@ctyfly.local

# ---- 是否播种演示内容 ----
# false，默认：只建表 + 创建管理员 + 系统权限表，不含任何示例航路/活动/公告/商城商品。
# true：本地开发想要这些示例数据时打开。生产环境请保持 false。
SEED_DEMO_DATA=false

# ---- 航情数据源的增强 Key，可选，不填也能用----
# METAR / TAF 默认使用免费公开源，aviationweather.gov / metar.vatsim.net / NOAA tgftp，
# 填了下面任意一个，该源会自动加入并发竞速，进一步提高可用性。
# CheckWX 免费注册：https://www.checkwxapi.com/
# AVWX   免费注册：https://avwx.rest/
# CHECKWX_API_KEY=你的CheckWXKey
# AVWX_TOKEN=你的AVWXToken

# ---- 网络代理，可选----
# 航情查询需要访问 aviationweather.gov；若服务器无法直连外网，
# 取消注释并按实际代理地址修改，httpx 默认遵循这两个环境变量：
# HTTPS_PROXY=http://127.0.0.1:7892
# HTTP_PROXY=http://127.0.0.1:7892

# ---- 自研工作量证明人机验证 ----
# 保护登录 / 注册 / 找回密码 / 发送验证码，不依赖任何第三方验证码服务：
# 服务端发 challenge，浏览器 Web Worker 算 nonce，服务端复算一次哈希即可验完。
POW_CAPTCHA_ENABLED=true
# 哈希十六进制结果需要的前导 0 位数，4 约等于平均 6.5 万次哈希
POW_CAPTCHA_DIFFICULTY=4
# challenge 有效期与通过后一次性令牌有效期，单位秒
POW_CAPTCHA_CHALLENGE_TTL=300
POW_CAPTCHA_TOKEN_TTL=600
# 令牌签名密钥，留空则回落到 JWT_SECRET；生产建议单独生成：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POW_CAPTCHA_SECRET=
# 本机回环 / 内网地址豁免验证，便于本地开发
# ⚠️ 生产环境必须为 false：true 等于任何本地来源都能跳过验证。
POW_CAPTCHA_ALLOW_LOCALHOST=true
